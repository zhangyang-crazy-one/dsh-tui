{
  "name": "@crazyhappyone/dsh-tui",
  "version": "0.1.0-alpha.49",
  "description": "DeepSeek Harness terminal interface: a dsh plugin bundle plus its launcher",
  "type": "module",
  "license": "MIT",
  "bin": {
    "dsh-tui": "bin/dsh-tui.js"
  },
  "exports": {
    "./runtime": "./dist/index.js",
    "./startup": "./dist/startup.js",
    "./settings": "./dist/settings.js",
    "./zen-proxy": "./dist/zen-proxy.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "assets/screenshots/*.png",
    "bin/dsh-tui.js",
    "src/**/*.js",
    "dist/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test tests/*.test.js",
    "pack:check": "npm pack --dry-run --json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangyang-crazy-one/dsh-tui.git"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "tui",
    "terminal"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
