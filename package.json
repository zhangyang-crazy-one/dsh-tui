{
  "name": "@crazyhappyone/dsh-tui",
  "version": "0.1.0-alpha.52",
  "description": "DeepSeek Harness terminal interface: a dsh plugin bundle plus its launcher",
  "type": "module",
  "license": "MIT",
  "bin": {
    "dsh-tui": "bin/dsh-tui.js"
  },
  "exports": {
    "./runtime": "./dist/index.js",
    "./startup": "./dist/startup.js",
    "./settings": "./dist/settings.js",
    "./schedule": "./dist/schedule.js",
    "./zen-proxy": "./dist/zen-proxy.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./presets/*.patch.yml": "./presets/*.patch.yml"
  },
  "files": [
    "assets/screenshots/*.png",
    "bin/dsh-tui.js",
    "src/**/*.js",
    "dist/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "presets/*.patch.yml",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "dev:setup": "node scripts/dev-setup.js",
    "typecheck": "node scripts/typecheck.js",
    "test": "node --test tests/*.test.js",
    "pack:check": "npm pack --dry-run --json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangyang-crazy-one/dsh-tui.git"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "tui",
    "terminal"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/base-disable.patch.yml",
        "./presets/registry.patch.yml",
        "./presets/standard.patch.yml",
        "./presets/ptc.patch.yml",
        "./presets/minimal.patch.yml",
        "./presets/cordis.patch.yml"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-instructions": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-tool-presentation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-command-compact": "0.2.1-rc.2",
    "@deepseek-ai/dsh-command-goal": "0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.2.1-rc.2",
    "@deepseek-ai/dsh-cordis-host-runner": "0.2.1-rc.2",
    "@deepseek-ai/dsh-persona": "0.2.1-rc.2",
    "@deepseek-ai/dsh-plan-mode": "0.2.1-rc.2",
    "@deepseek-ai/dsh-plugin-manager": "0.2.1-rc.2",
    "@deepseek-ai/dsh-plugin-market": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.2",
    "@deepseek-ai/dsh-terminal": "0.2.1-rc.2",
    "@deepseek-ai/dsh-terminal-bash": "0.2.1-rc.2",
    "@deepseek-ai/dsh-time-context": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-ask-user": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-bash": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-bash-persistent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-cordis": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-goal": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-jobs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-present": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-pwsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-pwsh-persistent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-schedule": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-subagent-control": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-todo": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-web": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-workflow": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workflow-ptc": "0.2.1-rc.2"
  }
}
